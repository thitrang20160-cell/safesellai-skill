          },
          "401": {
            "description": "API Key 无效",
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "description": "S算力 余额不足",
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "scope 不足 / 套餐不支持",
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "超出频率限制",
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/f6/blacklist": {
      "post": {
        "tags": [
          "f6"
        ],
        "summary": "新增黑名单地址",
        "description": "消耗：0。Scope：`write:f6`。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "street": "300 S Wacker Dr",
                "city": "Chicago",
                "state": "IL",
                "zip": "60606",
                "risk_reason": "自有名单"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已创建"
          },
          "400": {
            "description": "参数错误",
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "description": "API Key 无效",
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "description": "S算力 余额不足",
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "scope 不足 / 套餐不支持",
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "超出频率限制",
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/f6/blacklist/{id}": {
      "delete": {
        "tags": [
          "f6"
        ],
        "summary": "删除黑名单地址（仅本人添加）",
        "description": "消耗：0。Scope：`write:f6`。不可删除系统默认名单。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已删除"
          },
          "400": {
            "description": "参数错误",
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "description": "API Key 无效",
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "description": "S算力 余额不足",
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "scope 不足 / 套餐不支持",
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "不存在或无权"
          },
          "429": {
            "description": "超出频率限制",
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SafeSell AI API key",
        "description": "Bearer API Key"
      }
    },
    "responses": {
      "Error": {
        "description": "标准错误",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "error": {
                "code": "invalid_api_key",
                "message": "API Key 无效或已撤销"
              },
              "meta": {
                "request_id": "req_xxx"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorCodes": {
        "type": "string",
        "enum": [
          "invalid_api_key",
          "insufficient_scope",
          "plan_not_eligible",
          "rate_limit",
          "scoin_insufficient",
          "invalid_request",
          "not_found",
          "internal_error",
          "upstream_error"
        ]
      }
    }
  }
}
